# closeyourit-ruby — variables of the MONITORED project (not of the gem)
# In local development inject the secrets with `cyi run -p CYRB -e development -- <command>`;
# do not create a real .env and do not fall back to alternative providers if the CYRB vault is not configured.

# Base URL of the CloseYourIt server (the gem appends /api/v1/projects/:id/{events,metrics})
CLOSEYOURIT_ENDPOINT_URL=https://app.closeyour.it

# Bearer secret of the Projects::Token (shown ONCE at creation, on the CloseYourIt side)
CLOSEYOURIT_TOKEN=

# UUID of the project on CloseYourIt (appears in the ingest path)
CLOSEYOURIT_PROJECT_ID=

# Optional: version/release reported in error events
# CLOSEYOURIT_RELEASE=v1.2.3

# Optional: forces the environment reported in events (default: Rails.env / RACK_ENV)
# CLOSEYOURIT_ENVIRONMENT=production
